# ===================================================
# Social Earnings Studio - Environment Configuration
# ===================================================

# Application Environment (development | production)
NODE_ENV=development

# Flow AI & LLM Providers
# Leave blank for manual/guided workflow mode
FLOW_API_KEY=
FLOW_API_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Social Media OAuth (Optional for local testing / production deployment)
# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:42813/oauth/youtube/callback

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:42813/oauth/tiktok/callback

# Facebook Graph API / Meta for Developers
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:42813/oauth/facebook/callback

# Custom Executable Paths (Override auto-detected system binaries if needed)
FFMPEG_PATH=
ADB_PATH=
